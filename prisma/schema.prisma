// Prisma schema for the Construction Business Management System

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN // Full access: company owner / back office
  MANAGER // Project managers: manage projects, crews, budgets
  EMPLOYEE // Field crew: time tracking, task updates
  ACCOUNTANT // Billing & finance: invoices, payments, expenses
}

enum ProjectStatus {
  LEAD
  ESTIMATING
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  BANK_TRANSFER
  OTHER
}

enum ExpenseCategory {
  MATERIALS
  LABOR
  EQUIPMENT
  SUBCONTRACTOR
  PERMITS
  TRAVEL
  UTILITIES
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentCategory {
  CONTRACT
  PERMIT
  BLUEPRINT
  PHOTO
  INSURANCE
  INVOICE
  OTHER
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  phone        String?
  title        String? // e.g. "Site Foreman", "Estimator"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedProjects Project[]    @relation("ProjectManager")
  assignedTasks   Task[]       @relation("TaskAssignee")
  timeEntries     TimeEntry[]
  documents       Document[]   @relation("DocumentUploader")
  changeOrders    ChangeOrder[] @relation("ChangeOrderCreatedBy")

  @@index([role])
}

model Client {
  id          String   @id @default(cuid())
  name        String
  companyName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects  Project[]
  estimates Estimate[]
  invoices  Invoice[]

  @@index([name])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(LEAD)
  address     String?
  budget      Decimal?      @db.Decimal(14, 2)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientId String

  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  managerId String?

  tasks        Task[]
  timeEntries  TimeEntry[]
  estimates    Estimate[]
  invoices     Invoice[]
  expenses     Expense[]
  documents    Document[]
  changeOrders ChangeOrder[]
  equipment    Equipment[]

  @@index([status])
  @@index([clientId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  timeEntries TimeEntry[]

  @@index([projectId])
  @@index([status])
}

model TimeEntry {
  id        String   @id @default(cuid())
  date      DateTime
  hours     Decimal  @db.Decimal(5, 2)
  billable  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([projectId])
  @@index([userId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Estimates
// ---------------------------------------------------------------------------

model Estimate {
  id         String         @id @default(cuid())
  number     String         @unique
  status     EstimateStatus @default(DRAFT)
  issueDate  DateTime       @default(now())
  expiryDate DateTime?
  notes      String?
  taxRate    Decimal        @default(0) @db.Decimal(5, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientId String

  items EstimateItem[]

  @@index([projectId])
  @@index([status])
}

model EstimateItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  estimateId String

  @@index([estimateId])
}

// ---------------------------------------------------------------------------
// Invoices & Payments
// ---------------------------------------------------------------------------

model Invoice {
  id        String        @id @default(cuid())
  number    String        @unique
  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  notes     String?
  taxRate   Decimal       @default(0) @db.Decimal(5, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientId String

  items    InvoiceItem[]
  payments Payment[]

  @@index([projectId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  @@index([invoiceId])
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(BANK_TRANSFER)
  paidAt    DateTime      @default(now())
  notes     String?
  createdAt DateTime      @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory @default(OTHER)
  vendor      String?
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  description String?
  createdAt   DateTime        @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id       String           @id @default(cuid())
  name     String
  category DocumentCategory @default(OTHER)
  fileName String
  fileType String?
  fileSize Int?
  data     Bytes

  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  uploadedBy   User?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Equipment
// ---------------------------------------------------------------------------

model Equipment {
  id           String          @id @default(cuid())
  name         String
  type         String?
  serialNumber String?
  status       EquipmentStatus @default(AVAILABLE)
  purchaseDate DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  @@index([status])
}

// ---------------------------------------------------------------------------
// Change Orders
// ---------------------------------------------------------------------------

model ChangeOrder {
  id          String            @id @default(cuid())
  title       String
  description String?
  amount      Decimal           @db.Decimal(12, 2)
  status      ChangeOrderStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  createdBy   User?   @relation("ChangeOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@index([projectId])
}
